{
  "openapi": "3.1.0",
  "info": {
    "title": "exchange8-risk",
    "description": "Sentin8 exchange8 risk service.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/admin/attributes": {
      "get": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_list_attributes",
        "responses": {
          "200": {
            "description": "Principal attributes of this service",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PrincipalAttr"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "put": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_put_attribute",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutAttributeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Attribute stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttributeUpserted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid attribute definition"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "delete": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_delete_attribute",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "Attribute id to delete",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Attribute deleted"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/policy-sets": {
      "get": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_list_sets",
        "responses": {
          "200": {
            "description": "Policy sets of this service",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PolicySetRow"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/policy-sets/disable": {
      "post": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_mode_disable",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyModeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Sets disabled"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/policy-sets/enforce": {
      "post": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_mode_enforce",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyModeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Sets switched to enforce mode"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/policy-sets/shadow": {
      "post": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_mode_shadow",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyModeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Sets switched to shadow mode"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/policy-sets/{name}": {
      "get": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_get_set",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Policy set name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The policy set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicySetDetail"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          },
          "404": {
            "description": "Unknown policy set name"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "put": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_put_set",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Policy set name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutPolicySetBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Policy set stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicySetMutated"
                }
              }
            }
          },
          "400": {
            "description": "Invalid policy set definition"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "delete": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_delete_set",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Policy set name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Policy set deleted"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/policy-sets/{name}/test": {
      "post": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_test_set",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Policy set name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestPolicySetBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Dry-run decision trace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyTestOutcome"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/relations": {
      "get": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_list_relations",
        "responses": {
          "200": {
            "description": "ReBAC relations of this service",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RelationRecordRow"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "put": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_put_relation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutRelationBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Relation stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelationUpserted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid relation definition"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "delete": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_delete_relation",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "Relation id to delete",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Relation deleted"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/relations/check": {
      "get": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_check_relation",
        "parameters": [
          {
            "name": "subject",
            "in": "query",
            "description": "Subject key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "relation",
            "in": "query",
            "description": "Relation name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "object",
            "in": "query",
            "description": "Object key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The check verdict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelationCheckResult"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AttributeUpserted": {
        "type": "object",
        "description": "An attribute upsert result.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `upserted`."
          }
        }
      },
      "Decision": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "decision"
            ],
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "allow"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "reason",
              "decision"
            ],
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "deny"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        ]
      },
      "PolicyModeBody": {
        "type": "object",
        "description": "`POST /v1/admin/policy-sets/{mode}` body (RFW row actions).",
        "required": [
          "policy_set_name"
        ],
        "properties": {
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "policy_set_name": {
            "type": "string"
          }
        }
      },
      "PolicySetDetail": {
        "type": "object",
        "description": "One policy set in the detail view (adds the full policy text).",
        "required": [
          "policy_set_name",
          "description",
          "policies",
          "origin",
          "mode",
          "version",
          "enabled",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "description": "Creation instant (RFC 3339)."
          },
          "description": {
            "type": "string",
            "description": "Human description."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the set participates in evaluation."
          },
          "mode": {
            "type": "string",
            "description": "Evaluation mode."
          },
          "origin": {
            "type": "string",
            "description": "Row origin (`platform`/`tenant`)."
          },
          "policies": {
            "type": "string",
            "description": "The full policy text (Shield policy language)."
          },
          "policy_set_name": {
            "type": "string",
            "description": "The set name."
          },
          "schema": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional schema text bound to the set."
          },
          "updated_at": {
            "type": "string",
            "description": "Last update instant (RFC 3339)."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Monotonic revision."
          }
        }
      },
      "PolicySetMutated": {
        "type": "object",
        "description": "A stored policy-set mutation result.",
        "required": [
          "policy_set_name",
          "version",
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "description": "The evaluation mode after the mutation."
          },
          "policy_set_name": {
            "type": "string",
            "description": "The set name."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "The revision after the mutation."
          }
        }
      },
      "PolicySetRow": {
        "type": "object",
        "description": "One policy set in the list view (the RFW row shape).",
        "required": [
          "id",
          "policy_set_name",
          "description",
          "origin",
          "mode",
          "version",
          "enabled",
          "policies_len",
          "updated_at"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "Human description."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the set participates in evaluation."
          },
          "id": {
            "type": "string",
            "description": "The set name; doubles as the RFW row id."
          },
          "mode": {
            "type": "string",
            "description": "Evaluation mode (`shadow`/`enforced`)."
          },
          "origin": {
            "type": "string",
            "description": "Row origin (`platform` enroll-managed vs `tenant`)."
          },
          "policies_len": {
            "type": "integer",
            "format": "int64",
            "description": "Number of policy statements in the set."
          },
          "policy_set_name": {
            "type": "string",
            "description": "The set name."
          },
          "updated_at": {
            "type": "string",
            "description": "Last update instant (RFC 3339)."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Monotonic revision."
          }
        }
      },
      "PolicyTestOutcome": {
        "type": "object",
        "description": "A dry-run (test) outcome; nothing was stored.",
        "required": [
          "policy_set_name",
          "action",
          "decision",
          "would_deny"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "The action evaluated."
          },
          "decision": {
            "$ref": "#/components/schemas/Decision",
            "description": "The enforce-mode decision."
          },
          "policy_set_name": {
            "type": "string",
            "description": "The set name the candidate text was compiled under."
          },
          "would_deny": {
            "type": "boolean",
            "description": "Whether the shadow evaluation would deny."
          }
        }
      },
      "PrincipalAttr": {
        "type": "object",
        "description": "One principal attribute in the list view.",
        "required": [
          "subject_id",
          "attr_key",
          "attr_value",
          "origin"
        ],
        "properties": {
          "attr_key": {
            "type": "string",
            "description": "The attribute key."
          },
          "attr_value": {
            "description": "The attribute value (free-form JSON by contract)."
          },
          "origin": {
            "type": "string",
            "description": "Row origin."
          },
          "subject_id": {
            "type": "string",
            "description": "The attribute owner (subject id)."
          }
        }
      },
      "PutAttributeBody": {
        "type": "object",
        "description": "`PUT /v1/admin/attributes` body - one principal attribute.",
        "required": [
          "subject_id",
          "attr_key",
          "attr_value"
        ],
        "properties": {
          "attr_key": {
            "type": "string"
          },
          "attr_value": {},
          "subject_id": {
            "type": "string"
          }
        }
      },
      "PutPolicySetBody": {
        "type": "object",
        "description": "`PUT /v1/admin/policy-sets/{name}` body.",
        "required": [
          "policies"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "mode": {
            "type": [
              "string",
              "null"
            ]
          },
          "policies": {
            "type": "string"
          },
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PutRelationBody": {
        "type": "object",
        "description": "`PUT /v1/admin/relations` body - one relation tuple.",
        "required": [
          "subject_type",
          "subject_id",
          "relation",
          "object_type",
          "object_id"
        ],
        "properties": {
          "object_id": {
            "type": "string"
          },
          "object_type": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "subject_id": {
            "type": "string"
          },
          "subject_type": {
            "type": "string"
          }
        }
      },
      "RelationCheckResult": {
        "type": "object",
        "description": "A relation connectivity check result.",
        "required": [
          "subject",
          "relation",
          "object",
          "direct",
          "transitive",
          "connected",
          "tuple_count"
        ],
        "properties": {
          "connected": {
            "type": "boolean",
            "description": "`direct || transitive`."
          },
          "direct": {
            "type": "boolean",
            "description": "Whether a direct tuple exists."
          },
          "object": {
            "type": "string",
            "description": "The object in `type/id` form."
          },
          "relation": {
            "type": "string",
            "description": "The relation checked."
          },
          "subject": {
            "type": "string",
            "description": "The subject in `type/id` form."
          },
          "transitive": {
            "type": "boolean",
            "description": "Whether a transitive path exists."
          },
          "tuple_count": {
            "type": "integer",
            "description": "Number of tuples inspected.",
            "minimum": 0
          }
        }
      },
      "RelationRecordRow": {
        "type": "object",
        "description": "One relation tuple in the list view.",
        "required": [
          "subject_type",
          "subject_id",
          "relation",
          "object_type",
          "object_id",
          "origin"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "description": "The object entity id."
          },
          "object_type": {
            "type": "string",
            "description": "The object entity type."
          },
          "origin": {
            "type": "string",
            "description": "Row origin."
          },
          "relation": {
            "type": "string",
            "description": "The relation name."
          },
          "subject_id": {
            "type": "string",
            "description": "The subject entity id."
          },
          "subject_type": {
            "type": "string",
            "description": "The subject entity type."
          }
        }
      },
      "RelationUpserted": {
        "type": "object",
        "description": "A relation-tuple upsert result.",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The stored tuple id."
          },
          "status": {
            "type": "string",
            "description": "Always `upserted`."
          }
        }
      },
      "TestPolicySetBody": {
        "type": "object",
        "description": "`POST /v1/admin/policy-sets/{name}/test` body.",
        "required": [
          "policies",
          "subject_id"
        ],
        "properties": {
          "action": {
            "type": [
              "string",
              "null"
            ]
          },
          "policies": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Sample live-role names for role-based candidate rules."
          },
          "schema": {
            "type": [
              "string",
              "null"
            ]
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subject_id": {
            "type": "string"
          },
          "token_tp": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "risk",
      "description": "Exchange8:Risk"
    },
    {
      "name": "exchange8-admin",
      "description": "Exchange8 admin surface (RFW)"
    },
    {
      "name": "policy",
      "description": "Shield policy administration (shared surface)"
    }
  ]
}
